# Blue-Mango (Solana) frontend config
# Copy to .env.local and fill in.

# Solana RPC endpoint (devnet default)
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# Blue-Mango Anchor program id (set after `anchor deploy`)
NEXT_PUBLIC_PROGRAM_ID=

# SPL token for token-denominated deals (e.g. USDC mint). Leave empty to offer SOL only.
NEXT_PUBLIC_PAYMENT_MINT=
NEXT_PUBLIC_PAYMENT_SYMBOL=USDC
NEXT_PUBLIC_PAYMENT_DECIMALS=6
